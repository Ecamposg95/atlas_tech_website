# ============================================================
# Atlas Tech — Apache / Hostinger
# SPA routing + HTTPS + compresión + cache + seguridad
# (Se copia automáticamente a build/.htaccess al hacer `npm run build`)
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Forzar HTTPS (canónico, mejor para SEO) ---
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- Canónico SIN www (atlastech.mx) ---
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # --- /en sin redirección ---
  # mod_dir añade la barra final automáticamente cuando la ruta pedida es un
  # directorio (/en → 301 a /en/), lo que le mete un salto extra a la versión
  # en inglés. Serví el index.html generado por el SEO build directamente para
  # que /en y /en/ respondan 200 sin ese redirect.
  RewriteRule ^en/?$ /en/index.html [L]

  # --- SPA fallback ---
  # Si el archivo o carpeta existe (incluye los index.html por ruta que
  # genera el SEO), Apache lo sirve tal cual. Si no, carga la app.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# --- Compresión ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/x-javascript application/json \
    application/xml image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# --- Cache de assets estáticos ---
<IfModule mod_headers.c>
  # Assets con hash en el nombre (JS/CSS de CRA) → cache larga e inmutable
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML → siempre revalidar (para ver actualizaciones al instante)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
</IfModule>

# --- Headers de seguridad ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# --- Páginas de error ---
ErrorDocument 404 /index.html
