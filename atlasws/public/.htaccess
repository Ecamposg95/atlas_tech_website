# ============================================================
# Atlas Tech — Apache / Hostinger
# SPA routing + HTTPS + compresión + cache + seguridad
# (Se copia automáticamente a build/.htaccess al hacer `npm run build`)
# ============================================================

# Sin listados de carpetas.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Forzar HTTPS (canónico, mejor para SEO) ---
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- Canónico SIN www (atlastech.mx) ---
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # --- Direcciones anteriores → nuevas (reestructura 2026-11) ---
  # Mismas reglas que REDIRECTS en src/main-component/router/index.tsx.
  RewriteRule ^home/?$ / [R=301,L]
  RewriteRule ^about/?$ /nosotros [R=301,L]
  RewriteRule ^contact/?$ /contacto [R=301,L]
  RewriteRule ^service/?$ /cortex [R=301,L]
  RewriteRule ^service-details/?$ /cortex [R=301,L]
  RewriteRule ^proyectos/?$ /portafolio [R=301,L]
  RewriteRule ^proyectos/atlas-one/?$ /atlas-one [R=301,L]

  # --- Páginas por ruta, sin salto extra ---
  # El build genera un archivo por ruta (cortex.html, proyectos/harvestt.html…),
  # no una carpeta: así Apache no redirige /cortex → /cortex/.
  # La barra final se quita con un solo 301 hacia la dirección canónica.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /cortex sirve cortex.html (ya trae sus metadatos; React hidrata el cuerpo).
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^.]+)$ /$1.html [L]

  # Los .html por ruta no son direcciones públicas: van a su forma canónica.
  RewriteCond %{THE_REQUEST} \s/([^.\s?]+)\.html[\s?]
  RewriteCond %1 !^(index|404)$
  RewriteRule ^ /%1 [R=301,L]

  # --- SPA fallback ---
  # No hay comodín hacia index.html: toda ruta válida tiene su archivo.
  # Lo que no existe responde 404 con la página de error de la app (ver abajo).
</IfModule>

# --- Compresión ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/x-javascript application/json \
    application/xml image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# --- Cache de assets estáticos ---
<IfModule mod_headers.c>
  # Assets con hash en el nombre (JS/CSS de CRA) → cache larga e inmutable
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML → siempre revalidar (para ver actualizaciones al instante)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
</IfModule>

# --- Headers de seguridad ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# --- Páginas de error ---
# 404 real: se sirve la página de error de la app (noindex) con estado 404.
ErrorDocument 404 /404.html
